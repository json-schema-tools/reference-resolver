{
  "name": "@json-schema-tools/reference-resolver",
  "version": "1.3.0",
  "description": "Turns a $ref into a JSONSchema",
  "main": "build/index.js",
  "browser": "build/index-web.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:code && typedoc --out docs &&  touch docs/.nojekyll",
    "build:code": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:web",
    "test:unit": "npm run lint && jest --coverage --runInBand",
    "test:web": "npm run build:code && webpack && npx playwright install chromium && node scripts/test-web-browser.js && rm -rf dist",
    "coverage:bump": "jest-it-up"
  },
  "author": "BelfordZ<belfordz66@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/json-schema-tools/reference-resolver/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/json-schema-tools/reference-resolver.git"
  },
  "files": [
    "build",
    "!build/**/*.test.*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@json-schema-tools/meta-schema": "^1.7.5",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/jest": "^29.1.1",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^10.12.0",
    "jest": "^29.1.2",
    "jest-it-up": "^5.0.1",
    "playwright": "^1.64.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.26.6",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@json-schema-spec/json-pointer": "^0.1.2",
    "isomorphic-fetch": "^3.0.0"
  }
}
